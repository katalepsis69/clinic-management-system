# Copy this file to .env and fill in your values
# The chat bot uses Gemini AI when GEMINI_API_KEY is set;
# without it, it falls back to static FAQ keyword rules.

GEMINI_API_KEY=your-gemini-api-key-here
# Multiple keys for automatic failover and rate-limit rotation (comma-separated):
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_MODEL=gemini-3.6-flash
# ENABLE_WEB_SEARCH=true

# Optional overrides (defaults work for local dev)
# SECRET_KEY=change-me-in-production
# DATABASE_URL=sqlite:///./data/clinic.db
# DEMO_MODE=true

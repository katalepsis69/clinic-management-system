# Copy this file to .env and fill in your values
# The chat bot uses Gemini AI when GEMINI_API_KEY is set;
# without it, it falls back to static FAQ keyword rules.

GEMINI_API_KEY=your-gemini-api-key-here
# Multiple keys for automatic failover and rate-limit rotation (comma-separated):
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_MODEL=gemini-3.6-flash
# ENABLE_WEB_SEARCH=true

# Local development defaults (seeded demo accounts enabled)
# DEMO_MODE=true
# DATABASE_URL=sqlite:///./data/clinic.db

# Production configuration (required when DEMO_MODE=false):
# Set DEMO_MODE=false and generate a strong random SECRET_KEY (must NOT start with "dev-secret"),
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# DEMO_MODE=false
# SECRET_KEY=replace-with-64-char-random-hex-secret
